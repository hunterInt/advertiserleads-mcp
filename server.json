{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.advertiserleads/mcp",
  "title": "AdvertiserLeads",
  "description": "Ecommerce brands that just started, scaled or stopped Meta ads, with store platform and pixels",
  "version": "1.1.0",
  "websiteUrl": "https://advertiserleads.com/?utm_source=mcp-registry&utm_medium=listing&utm_campaign=mcp",
  "repository": {
    "url": "https://github.com/hunterInt/advertiserleads-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://advertiserleads.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. Your AdvertiserLeads API key from Settings. Leave empty to sign in with OAuth instead, or to use the server anonymously with lower limits.",
          "value": "Bearer {api_key}",
          "isRequired": false,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "AdvertiserLeads API key (starts with al_)",
              "placeholder": "al_...",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
